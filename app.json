{
  "expo": {
    "name": "Payport",
    "slug": "payport",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "payport",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/logo-mark-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#EAF6FC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "zw.co.payport.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Payport uses Face ID to securely confirm payments and log you in quickly.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#091E3E"
      },
      "package": "zw.co.payport.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#06A3DA"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EAF6FC",
          "image": "./assets/logo-mark-transparent.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Payport uses the camera to scan merchant QR codes."
        }
      ],
      "./plugins/withPayportTap"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.payport.africa"
    }
  }
}
